{
  "name": "deepdiscovery",
  "version": "0.1.0",
  "description": "DeepDiscovery: A Location–Inference framework for task-level repository understanding in industrial codebases.",
  "keywords": [
    "repository-understanding",
    "code-retrieval",
    "llm",
    "repomap",
    "location-inference"
  ],
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deepdiscovery": "dist/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:engine": "cd vendor/repoamap && npm install && npm run build",
    "build:all": "npm run build:engine && npm run build",
    "postinstall": "npm run build:engine || echo 'repoamap engine build skipped; run: npm run build:engine'",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx examples/basic.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "graphlib": "^2.1.8",
    "ignore": "^7.0.3",
    "repomix": "^1.1.0",
    "tree-sitter-wasms": "^0.1.11",
    "web-tree-sitter": "^0.22.6"
  },
  "devDependencies": {
    "@types/graphlib": "^2.1.12",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.0"
  }
}
