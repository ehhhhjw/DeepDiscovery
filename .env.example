# === LLM (Anthropic-compatible) ===
# API key for the Anthropic-compatible endpoint.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: override the base URL to use an Anthropic-compatible gateway/proxy.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model id used for all reasoning steps (env-aware analysis, anchor localization, inference).
DD_MODEL=claude-opus-4-8

# === DeepDiscovery framework parameters (see paper §III) ===
# B_max: exploration budget as an approximate token cap for a single context slice.
DD_BUDGET=60000
# kappa (κ): metadata -> full-text promotion threshold in [0,1]. Lower promotes more full text.
DD_KAPPA=0.6
# tau_stop (τ_stop): expansion stop threshold in [0,1]. Higher stops expansion earlier.
DD_TAU_STOP=0.3

# === Misc ===
# Verbose logging: true|false
DD_VERBOSE=false
# Directory for caching compression / located-file results (defaults to OS cache dir).
# DD_CACHE_DIR=./.deepdiscovery-cache
